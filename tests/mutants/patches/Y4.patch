# Description: module carte avec son propre hook, sans garde secret (text:match sur la valeur brute)
# Expect: fail
@@ replace-file Modules/WorldMap.lua
local addonName, WT = ...
local st = {}
local fs
local busy = false
local function tr(text)
  if type(text) ~= "string" or text == "" then return nil end
  local name, suffix = text:match("^(.-)(|c%x%x%x%x%x%x%x%x %(.-%)|r)$")
  if not name then name, suffix = text, "" end
  local r = WT.Translate(name)
  return r and (r .. suffix) or nil
end
local function set(t) busy = true; fs:SetText(t); busy = false end
local function try(text)
  local r = tr(text)
  if r and r ~= text then st.applied = r; set(r) end
end
local function setup()
  if fs or not WorldMapFrame or not WorldMapFrame.dataProviders then return end
  for p in pairs(WorldMapFrame.dataProviders) do
    if p.Label and p.Label.Name then fs = p.Label.Name end
  end
  if not fs then return end
  hooksecurefunc(fs, "SetText", function(self, text)
    if busy then return end
    st.original, st.applied = text, nil
    if WT.IsActive() then try(text) end
  end)
end
setup()
local f = CreateFrame("Frame")
f:RegisterEvent("ADDON_LOADED")
f:SetScript("OnEvent", function(self, event, name)
  if name == "Blizzard_WorldMap" then setup() end
end)
WT.RegisterModule("WorldMap", {
  Apply = function()
    if fs and not st.applied then st.original = fs:GetText(); try(st.original) end
  end,
  Restore = function()
    if fs and st.applied and fs:GetText() == st.applied then set(st.original) end
    st.applied = nil
  end,
})
